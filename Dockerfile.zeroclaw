FROM alpine:latest AS builder
ARG TARGETARCH
WORKDIR /builder
COPY . .
RUN case "$TARGETARCH" in \
      amd64) VARIANT=x86_64-unknown-linux-gnu ;; \
      arm64) VARIANT=aarch64-unknown-linux-gnu ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && mv "zeroclaw-${VARIANT}/zeroclaw" ./zeroclaw

FROM ubuntu:24.04
COPY --from=builder --chmod=755 /builder/zeroclaw /usr/local/bin/zeroclaw
COPY --from=builder /builder/web-dist /usr/share/zeroclawlabs/web/dist

# Match upstream to ensure our data directory is in the same place.
RUN mkdir -p /zeroclaw-data/.zeroclaw /zeroclaw-data/data \
 && chown -R 65534:65534 /zeroclaw-data

ENV LANG=C.UTF-8
ENV HOME=/zeroclaw-data
ENV ZEROCLAW_DATA_DIR=/zeroclaw-data/data
ENV ZEROCLAW_gateway__port=42617

WORKDIR /zeroclaw-data
USER 65534:65534
EXPOSE 42617

ENTRYPOINT ["zeroclaw"]
CMD ["daemon"]
